# syntax=docker/dockerfile:1
FROM node:22-alpine AS base

RUN apk add --no-cache curl

WORKDIR /app

# Copy root package manifests and configs
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY tools/evaluate/package.json ./tools/evaluate/

# Clean install all dependencies
RUN npm ci

# Copy application source code
COPY packages/core ./packages/core
COPY apps/api ./apps/api

# Switch to non-root user
USER node

EXPOSE 4000

ENV NODE_ENV=production \
    PORT=4000

HEALTHCHECK --interval=5s --timeout=5s --start-period=5s --retries=5 \
  CMD curl -f http://localhost:4000/health/ready || exit 1

CMD ["npm", "run", "start", "--workspace=@kit/api"]
