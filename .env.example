# ---------------------------------------------------------------------------
# AI Interview Preparation Kit - Environment Contract
# Copy to .env and fill in. NEVER commit a real .env.
# ---------------------------------------------------------------------------

# ===========================================================================
# SERVER-SIDE ONLY (Never exposed to browser bundle)
# ===========================================================================

# --- MongoDB Replica Set (Required for transactions) -----------------------
# Local Docker Compose replica set:
# MONGODB_URI=mongodb://mongo:27017/interview_kit?replicaSet=rs0
# Local standalone with direct replica set:
# MONGODB_URI=mongodb://127.0.0.1:27017/interview_kit?replicaSet=rs0&directConnection=true
MONGODB_URI=mongodb://127.0.0.1:27017/interview_kit?replicaSet=rs0&directConnection=true
MONGODB_DB=interview_kit

# --- Express API (apps/api) ------------------------------------------------
PORT=4000
WEB_ORIGIN=http://localhost:3000
SESSION_TTL_HOURS=168
PIPELINE_BUDGET_MS=150000

# --- Standalone Worker (apps/api/src/worker.ts) ----------------------------
WORKER_POLL_INTERVAL_MS=2000

# --- Next.js Web Server Proxy (apps/web) -----------------------------------
# Read only by Next.js Server Components and reverse proxy rewrites (/api/*).
# Browser JS never sees or consumes this value directly.
API_PROXY_TARGET=http://localhost:4000

# --- LLM Providers ---------------------------------------------------------
# gemini | groq | mock
# mock = deterministic, offline, zero network. Used by CI and reproducible evaluation.
LLM_PROVIDER=mock
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
GROQ_MODEL=openai/gpt-oss-120b
LLM_TIMEOUT_MS=30000

# Opt-in only for live provider testing. Set to 1 to run real external API tests.
LLM_SMOKE=

# --- Optional Search Provider ----------------------------------------------
# When unset, stage 9 records an honest research gap instead of guessing.
TAVILY_API_KEY=

# --- Crawler / Retrieval Security & Boundaries -----------------------------
CRAWL_MAX_PAGES=5
CRAWL_BUDGET_MS=45000
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
USER_AGENT=ai-interview-prep-kit/0.1

# --- Evaluator Exception (Tools/evaluate only) ------------------------------
# Comma-separated host:port pairs permitted to resolve to private addresses.
# Consumed ONLY by tools/evaluate. Deployed API ignores this by construction.
EVAL_ALLOW_PRIVATE_HOSTS=

# ===========================================================================
# PUBLIC (Browser-accessible)
# ===========================================================================
# NONE. All authentication uses HttpOnly first-party cookies.
# No NEXT_PUBLIC_* credentials or secrets are permitted in the client bundle.
