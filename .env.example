# ---------------------------------------------------------------------------
# AI Interview Preparation Kit - environment template
# Copy to .env and fill in. NEVER commit a real .env.
# The batch evaluator reads credentials from environment variables only.
# ---------------------------------------------------------------------------

# --- LLM ---------------------------------------------------------------------
# gemini | groq | mock
# mock  = deterministic, offline, no network. Used by CI and reproducible runs.
LLM_PROVIDER=gemini
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash
GROQ_API_KEY=
# Verify the current Groq model id at implementation time; ids are retired.
GROQ_MODEL=llama-3.3-70b-versatile
LLM_TIMEOUT_MS=30000

# --- Optional: public interview-discussion search -----------------------------
# When unset, stage 9 records an honest research gap instead of guessing.
# We do not scrape search-engine result pages (see docs/SECURITY.md).
TAVILY_API_KEY=

# --- Retrieval / crawler ------------------------------------------------------
CRAWL_MAX_PAGES=5
CRAWL_BUDGET_MS=45000
FETCH_TIMEOUT_MS=8000
FETCH_MAX_BYTES=2000000
FETCH_MAX_REDIRECTS=3
USER_AGENT=ai-interview-prep-kit/0.1

# --- Evaluator-only escape hatch ---------------------------------------------
# Comma-separated host:port entries permitted to resolve to private addresses.
# Consumed ONLY by tools/evaluate. The deployed API ignores this variable by
# construction - see docs/SECURITY.md "Evaluator exception".
# Example: EVAL_ALLOW_PRIVATE_HOSTS=localhost:8099,127.0.0.1:8099
EVAL_ALLOW_PRIVATE_HOSTS=

# --- API (apps/api) -----------------------------------------------------------
MONGODB_URI=
MONGODB_DB=interview_kit
PORT=4000
SESSION_TTL_HOURS=168
WEB_ORIGIN=http://localhost:3000
# Per-case wall-clock ceiling for a generation run.
PIPELINE_BUDGET_MS=150000

# --- Web (apps/web) -----------------------------------------------------------
# The browser always talks to /api on its own origin; Next.js proxies to the API
# so session cookies stay first-party. See docs/ARCHITECTURE.md.
API_PROXY_TARGET=http://localhost:4000
