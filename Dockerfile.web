# syntax=docker/dockerfile:1
FROM node:22-alpine AS builder

WORKDIR /app

# Copy root manifests and configs
COPY package.json package-lock.json tsconfig.base.json tsconfig.json ./
COPY packages/core/package.json ./packages/core/
COPY apps/api/package.json ./apps/api/
COPY apps/web/package.json ./apps/web/
COPY tools/evaluate/package.json ./tools/evaluate/

RUN npm ci

# Copy application source code
COPY packages/core ./packages/core
COPY apps/web ./apps/web

# Build Next.js production bundle
WORKDIR /app/apps/web
ENV NODE_ENV=production \
    NEXT_TELEMETRY_DISABLED=1
RUN npm run build

# Production runner stage
FROM node:22-alpine AS runner

RUN apk add --no-cache curl

WORKDIR /app

# Copy entrypoint script
COPY apps/web/docker-entrypoint.sh /usr/local/bin/docker-entrypoint.sh
RUN chmod +x /usr/local/bin/docker-entrypoint.sh

COPY --chown=node:node --from=builder /app/package.json /app/package-lock.json ./
COPY --chown=node:node --from=builder /app/node_modules ./node_modules
COPY --chown=node:node --from=builder /app/apps/web ./apps/web
COPY --chown=node:node --from=builder /app/packages/core ./packages/core

USER node

WORKDIR /app/apps/web

ENV NODE_ENV=production \
    PORT=3000 \
    NEXT_TELEMETRY_DISABLED=1

EXPOSE 3000

HEALTHCHECK --interval=5s --timeout=5s --start-period=10s --retries=5 \
  CMD curl -f http://localhost:3000/login || exit 1

ENTRYPOINT ["docker-entrypoint.sh"]
CMD ["npx", "next", "start", "-p", "3000"]
